{
  "name": "pilot",
  "version": "2.2.0",
  "description": "Alpaca Pilot for the Benro Polaris",
  "productName": "Alpaca Pilot App",
  "author": "David Morrison",
  "type": "module",
  "private": true,
  "scripts": {
    "9000": "powershell -Command \"Get-NetTCPConnection -LocalPort 9000 -ErrorAction SilentlyContinue | ForEach-Object { Stop-Process -Id $_.OwningProcess -Force }\"",
    "9001": "netstat -aon | findstr :9000",
    "lint": "eslint -c ./eslint.config.js \"./src*/**/*.{ts,js,cjs,mjs,vue}\"",
    "format": "prettier --write \"**/*.{js,ts,vue,scss,html,md,json}\" --ignore-path .gitignore",
    "test": "echo \"No test specified\" && exit 0",
    "dev": "quasar dev",
    "build": "quasar build",
    "postinstall": "quasar prepare"
  },
  "overrides": {
    "esbuild": "^0.28.1",
    "markdown-it": ">=14.2.0",
    "js-yaml": "^4.3.2",
    "fast-uri": ">=4.1.3",
    "nanoid": ">=5.1.11",
    "immutable": ">=5.1.8",
    "postcss": ">=8.5.23",
    "linkify-it": ">=5.0.2"
  },
  "dependencies": {
    "@quasar/extras": "^2.1.0",
    "@vueuse/core": "^14.4.0",
    "axios": ">=1.18.0",
    "d3": "^7.9.0",
    "leaflet": "^1.9.4",
    "pinia": "^3.0.3",
    "quasar": "^2.33.1",
    "vue": "^3.4.18",
    "vue-router": "^5.3.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.14.0",
    "@quasar/app-vite": "^3.10.0",
    "@quasar/quasar-app-extension-qmarkdown": "^4.2.1",
    "@types/d3": "^7.4.3",
    "@types/leaflet": "^1.9.20",
    "@types/node": "^20.5.9",
    "@vue/eslint-config-prettier": "^10.1.0",
    "@vue/eslint-config-typescript": "^14.4.0",
    "autoprefixer": "^10.4.2",
    "eslint": "^10.9.0",
    "eslint-plugin-vue": "^10.10.0",
    "globals": "^15.12.0",
    "prettier": "^3.3.3",
    "typescript": "^5.9.3",
    "vite-plugin-checker": "^0.14.5",
    "vue-tsc": "^2.0.29"
  },
  "engines": {
    "node": "^28 || ^26 || ^24 || ^22 || ^20 || ^18",
    "npm": ">= 6.13.4",
    "yarn": ">= 1.21.1"
  }
}
